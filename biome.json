{
  "files": {
    "includes": [
      "**",
      "!!**/.claude",
      "!**/dist",
      "!**/dist-e2e",
      "!**/node_modules",
      "!ml",
      "!docs/source",
      "!scenarios/**/cases",
      "!evals/held-out/catalog",
      "!scenarios/**/fixtures"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "recommended": true
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}

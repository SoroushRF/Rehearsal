# Copy to .env. Core mode must start with only the "Core" section filled in.

# --- Core -------------------------------------------------------------------
DATABASE_URL=postgres://rehearsal:rehearsal@localhost:5432/rehearsal
API_PORT=3000
# Optional: a separate database for `pnpm rehearsal test --db`. Without it the Postgres tests use
# DATABASE_URL, and a running executor worker picks up the apply jobs they leave behind.
# TEST_DATABASE_URL=postgres://rehearsal:rehearsal@localhost:5432/rehearsal_test

# Era simulator worlds (server-selected; the planner never chooses these).
# Planning world = the fork the agent works in. Operational world = simulated "production".
ERA_STRIPE_PLANNING_URL=http://127.0.0.1:8101
ERA_STRIPE_OPERATIONAL_URL=http://127.0.0.1:8102
ERA_ZENDESK_PLANNING_URL=http://127.0.0.1:8111
ERA_ZENDESK_OPERATIONAL_URL=http://127.0.0.1:8112
ERA_TENANT=rehearsal-demo
# Protects /_admin and tenant minting on every simulator. API (operator) and operator scripts
# only: never a worker. See docs/decisions/0002-era-tenant-token-minting.md.
ERA_ADMIN_TOKEN=change-me-local-only
# Execution rehearsal worlds (decision 0013, `pnpm infra:up:rehearsal`): separate containers with
# their own admin token, which can't touch the planning or operational worlds. Operator only.
ERA_STRIPE_REHEARSAL_URL=http://127.0.0.1:8103
ERA_ZENDESK_REHEARSAL_URL=http://127.0.0.1:8113
ERA_SLACK_REHEARSAL_URL=http://127.0.0.1:8123
REHEARSAL_ERA_ADMIN_TOKEN=change-me-rehearsal-local-only
# The execution-rehearsal worker's own secret: it mints only rh-<id> tokens, only while that rehearsal
# is provisioned. It must differ from the other two worker secrets. Planner and executor refuse it.
REHEARSAL_WORKER_SECRET=change-me-rehearsal-worker-local-only

# Workers mint their Era tenant tokens through the API with their own secret. The secret picks
# the world: planner -> planning, executor -> operational. Give each worker only its own secret;
# the two must differ.
REHEARSAL_API_URL=http://127.0.0.1:3000
PLANNER_WORKER_SECRET=change-me-planner-local-only
EXECUTOR_WORKER_SECRET=change-me-executor-local-only

# Planner worker only. It refuses to start next to DATABASE_URL, ERA_ADMIN_TOKEN, the operational
# URLs or EXECUTOR_WORKER_SECRET, so `pnpm --filter @rehearsal/planner-worker dev` reads its own
# .env.planner with just: ERA_STRIPE_PLANNING_URL, ERA_ZENDESK_PLANNING_URL, ERA_TENANT,
# REHEARSAL_API_URL, PLANNER_WORKER_SECRET, ANTHROPIC_API_KEY and PLANNER_MODEL.
# See docs/decisions/0006-planner-jobs-through-api.md.
ANTHROPIC_API_KEY=
PLANNER_MODEL=claude-sonnet-5-5
# Or a gemini-* model on Vertex AI, with the worker's Google credentials (ADC) and no Anthropic key:
# PLANNER_MODEL=gemini-4-argon
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global

# API + web (Clerk)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
# Optional: origins allowed to present session tokens, comma-separated (e.g. http://localhost:5173)
CLERK_AUTHORIZED_PARTIES=

# --- Full extensions (optional; core runs without these) ---------------------
ERA_SLACK_PLANNING_URL=http://127.0.0.1:8121
ERA_SLACK_OPERATIONAL_URL=http://127.0.0.1:8122
# Run summary (T1.7): the planner worker proposes a post to this channel; the executor worker
# needs ERA_SLACK_OPERATIONAL_URL to send it, and the API needs it to mint the executor's token.
RUN_SUMMARY_CHANNEL=
# Public customer replies (T1.13): 1 lets the planner propose one per refund, from the approved
# refund-issued template and the customer's name in the incident report.
CUSTOMER_REPLIES=
# Invoice-balance credits (T1.14): 1 plans under policy v2, where a duplicate below its credit limit
# may be credited to the customer's balance instead of refunded. Planner worker only.
BALANCE_CREDITS=
# SurrealDB Agent Memory precedents (T1.8): host, context ID and data-plane key from Studio.
# Set all three or none. The scope defaults to rehearsal/precedents.
SURREAL_AGENT_MEMORY_URL=
SURREAL_AGENT_MEMORY_CONTEXT=
SURREAL_AGENT_MEMORY_KEY=
SURREAL_AGENT_MEMORY_SCOPE=
IMPACT_SERVICE_URL=

{
  "name": "rehearsal",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=24.11.1 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @rehearsal/api --filter @rehearsal/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:core": "vitest run --project core --project contracts --project testkit",
    "test:providers": "vitest run --project providers",
    "lint": "biome check .",
    "format": "biome format --write .",
    "fixtures:write": "tsx scripts/seed/write-bundles.ts",
    "fixtures:capture": "tsx --env-file-if-exists=.env scripts/seed/capture-era-fixtures.ts",
    "infra:up": "docker compose -f infra/compose.yaml up -d",
    "demo:reset": "tsx --env-file-if-exists=.env scripts/inject/reset.ts",
    "demo:phantom": "tsx --env-file-if-exists=.env scripts/inject/phantom.ts",
    "demo:conflict": "tsx --env-file-if-exists=.env scripts/inject/conflict.ts",
    "demo:fault": "tsx --env-file-if-exists=.env scripts/inject/fault.ts",
    "infra:up:full": "docker compose -f infra/compose.yaml --profile full up -d",
    "infra:down": "docker compose -f infra/compose.yaml down",
    "smoke:era": "tsx --env-file-if-exists=.env scripts/smoke/era-meta.ts",
    "blockers": "node scripts/blockers/generate.ts",
    "smoke:apply": "tsx --env-file-if-exists=.env scripts/smoke/apply-e2e.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@rehearsal/core": "workspace:*",
    "@rehearsal/db": "workspace:*",
    "@rehearsal/providers": "workspace:*",
    "@rehearsal/testkit": "workspace:*",
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}

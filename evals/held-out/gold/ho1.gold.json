          ],
          "why": "189.00 CAD is over both the finance threshold and the credit limit."
        },
        "a03": {
          "accept": ["refunded"],
          "mustNotApply": [
            {
              "op": "stripe.customer.balanceCredit",
              "cause": "policy"
            }

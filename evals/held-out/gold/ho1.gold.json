          ],
          "why": "Exactly 100.00 CAD: the finance threshold applies at the boundary and a credit must be below the limit."
        },
        "a05": {
          "accept": ["refunded_two", "credited_two", "refunded_and_credited"],
          "why": "Three identical payments of one invoice: keep the earliest, remedy the other two."
